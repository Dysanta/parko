{
  "expo": {
    "name": "Parko",
    "slug": "parko-parking",
    "scheme": "parko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/parko-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Autoriser Parko à photographier les plaques d’immatriculation.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-ocr-kit",
      "expo-sharing",
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.parkoparking"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/parko-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.parkoparking"
    },
    "web": {
      "favicon": "./public/apple-touch-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "34b13db2-b483-447f-9428-67ce48cc7388"
      }
    }
  }
}
